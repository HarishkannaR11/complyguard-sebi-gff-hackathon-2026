DATABASE_URL=postgresql://regops:regops@localhost:5433/regops
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
QDRANT_URL=http://localhost:6333
ALLOW_MEMORY_CHECKPOINTER=false

# --- API security -----------------------------------------------------------
# Comma-separated "key:user" pairs. Leave empty to disable auth (local dev only).
# With auth on, the key's user becomes the audit-trail actor for review decisions.
API_KEYS=
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Upload size cap in MB (PDFs and CSVs).
MAX_UPLOAD_MB=25
