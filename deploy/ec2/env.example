# Copy to deploy/ec2/.env (chmod 600). Values are read by docker-compose.prod.yml.
# Wrap values in single quotes if they contain $ # or spaces.

POSTGRES_PASSWORD=change-me-to-a-long-random-string
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# key:user pairs, comma separated. REQUIRED for anything reachable from the internet.
API_KEYS=change-me-key:alice
# Frontend build arg. Visible to every visitor -- pick a key meant for the UI only.
VITE_API_KEY=change-me-key

# Domain => automatic HTTPS (point its A record at this host first). Default is plain HTTP.
SITE_ADDRESS=:80
